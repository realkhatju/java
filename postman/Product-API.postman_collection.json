{
  "info": {
    "_postman_id": "6f2f7f8e-2b5a-4d6f-9f0c-1a2b3c4d5e6f",
    "name": "Product API - CRUD",
    "description": "Full CRUD collection for the Spring Boot Product API.\n\nRun the collection in order (Collection Runner) so that the Create request captures `productId` and `productSku` for the following requests.\n\nDefault base URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Application is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testSku', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response has an id', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('SKU matches the request', () => pm.expect(body.sku).to.eql(pm.collectionVariables.get('testSku')));",
                  "pm.test('Location header points to the new resource', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/products/'));",
                  "pm.collectionVariables.set('productId', body.id);",
                  "pm.collectionVariables.set('productSku', body.sku);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{testSku}}\",\n  \"name\": \"Postman Product\",\n  \"description\": \"Created by the Postman collection\",\n  \"category\": \"Postman\",\n  \"price\": 49.99,\n  \"stock\": 25,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the requested product', () => pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get('productId'))));",
                  "pm.test('Product is active', () => pm.expect(body.active).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product by SKU",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('SKU lookup is case-insensitive', () => pm.expect(body.sku).to.eql(pm.collectionVariables.get('productSku')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/sku/{{productSku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "sku",
                "{{productSku}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Products (filter, sort, paginate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a paginated payload', () => {",
                  "  pm.expect(body.content).to.be.an('array');",
                  "  pm.expect(body).to.have.property('totalElements');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "});",
                  "pm.test('Every result matches the category filter', () => {",
                  "  body.content.forEach(product => pm.expect(product.category).to.eql('Postman'));",
                  "});",
                  "pm.test('Results are sorted by price ascending', () => {",
                  "  const prices = body.content.map(product => product.price);",
                  "  const sorted = [...prices].sort((a, b) => a - b);",
                  "  pm.expect(prices).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=0&size=5&sortBy=price&direction=asc&category=Postman&minPrice=10&maxPrice=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "direction",
                  "value": "asc"
                },
                {
                  "key": "category",
                  "value": "Postman"
                },
                {
                  "key": "minPrice",
                  "value": "10"
                },
                {
                  "key": "maxPrice",
                  "value": "100"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Product (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Name was replaced', () => pm.expect(body.name).to.eql('Postman Product Updated'));",
                  "pm.test('Price was replaced', () => pm.expect(body.price).to.eql(59.99));",
                  "pm.test('Version was incremented', () => pm.expect(body.version).to.be.at.least(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"Postman Product Updated\",\n  \"description\": \"Replaced with PUT\",\n  \"category\": \"Postman\",\n  \"price\": 59.99,\n  \"stock\": 30,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Patch Product (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Stock was patched', () => pm.expect(body.stock).to.eql(5));",
                  "pm.test('Active was patched', () => pm.expect(body.active).to.eql(false));",
                  "pm.test('Unpatched fields are unchanged', () => pm.expect(body.name).to.eql('Postman Product Updated'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 39.99,\n  \"stock\": 5,\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Get Missing Product (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Response is a Problem Details document', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "const body = pm.response.json();",
                  "pm.test('Problem title is set', () => pm.expect(body.title).to.eql('Resource not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "999999"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Duplicate SKU (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('Problem title is set', () => pm.expect(body.title).to.eql('Duplicate resource'));",
                  "pm.test('Detail mentions the SKU', () => pm.expect(body.detail).to.include(pm.collectionVariables.get('productSku')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"Duplicate Product\",\n  \"category\": \"Postman\",\n  \"price\": 10.00,\n  \"stock\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Invalid Product (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Validation errors are returned', () => {",
                  "  pm.expect(body.title).to.eql('Validation failed');",
                  "  pm.expect(body.errors).to.have.property('sku');",
                  "  pm.expect(body.errors).to.have.property('name');",
                  "  pm.expect(body.errors).to.have.property('price');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"bad sku!\",\n  \"name\": \"\",\n  \"category\": \"\",\n  \"price\": -5,\n  \"stock\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
