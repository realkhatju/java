# Server
SERVER_PORT=8080

# Application
APP_SEED_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=*

# PostgreSQL profile (application-postgres.yml)
DB_URL=jdbc:postgresql://localhost:5432/productdb
DB_USERNAME=product
DB_PASSWORD=product

